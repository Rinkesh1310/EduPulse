# ==============================================================
# EduPulse Frontend Environment Variables
# ==============================================================
#
# Development (Local):
# Leave VITE_API_BASE_URL empty or unset to use the Vite local proxy (/api -> http://127.0.0.1:8000).
# VITE_API_BASE_URL=/api
#
# Production (Vercel):
# Set VITE_API_BASE_URL in your Vercel Project Settings > Environment Variables
# to the public URL of your deployed FastAPI backend (e.g. on Render, Fly.io, Railway, or Google Cloud Run).
# Example:
# VITE_API_BASE_URL=https://edupulse-api.onrender.com
#
VITE_API_BASE_URL=/api
